# Hermes Agent Configuration
# Copy to .env and fill in your secrets

# ============================================================================
# API Keys & Credentials
# ============================================================================

# Google Gemini (default provider — gemini-2.5-flash)
# Either name works; Hermes accepts GOOGLE_API_KEY or GEMINI_API_KEY.
GOOGLE_API_KEY=...

# Anthropic Claude (optional — switch via /model in Telegram)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional — switch via /model in Telegram)
# OPENAI_API_KEY=sk-...

# Z.AI / Zhipu GLM (optional — switch via /model in Telegram)
# ZAI_API_KEY=...

# OpenRouter aggregator (optional — gives access to 200+ models with one key)
# OPENROUTER_API_KEY=sk-or-...

# Seed config selector: gemini (default) | anthropic | openai
# Only applied on first boot when /opt/data/config.yaml doesn't exist.
# Subsequent restarts preserve user's /model selection from Telegram.
# HERMES_PROVIDER_CONFIG=gemini

# Force-overwrite config.yaml on next boot (one-shot recovery if your bot is
# stuck on a dead provider). Backs up the old config to config.yaml.bak.
# After the redeploy, REMOVE this var to restore preserve-mode.
# HERMES_FORCE_RESEED=1

# Disable auto-recovery (default ON). When ON, railway-start.sh detects if the
# active provider in /opt/data/config.yaml has no matching API key in env and
# reseeds with the default provider. Prevents the bot from being stuck on a
# dead provider after /model switch + key removal.
# HERMES_DISABLE_AUTO_RECOVERY=1

# Workaround for upstream i18n bug (Hermes v0.14.x has incomplete Russian locale,
# bot shows raw keys like gateway.model.switched instead of translated text).
# Set to "en" until upstream fixes Russian translations.
HERMES_LOCALE=en


# ============================================================================
# Telegram Gateway
# ============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# ============================================================================
# Docker & Container
# ============================================================================

# Data directory (mounted volume)
HERMES_HOME=/opt/data

# Dashboard
HERMES_DASHBOARD=1
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_HOST=0.0.0.0

# UID/GID mapping (for volume ownership)
HERMES_UID=10000
HERMES_GID=10000

# ============================================================================
# Railway Deployment
# ============================================================================

# Railway will auto-set these
# PORT=8080
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=...
# RAILWAY_SERVICE_NAME=...

# Skip gateway on Railway (dashboard-only mode)
# HERMES_RAILWAY_SKIP_GATEWAY=0

# ============================================================================
# Optional: OAuth Bootstrap (Railway provisioning only)
# ============================================================================

# For orchestrated deployments that seed OAuth non-interactively.
# First boot only — subsequent token rotations write to auth.json.
# HERMES_AUTH_JSON_BOOTSTRAP={"refresh_token":"..."}

# ============================================================================
# Agent Customization
# ============================================================================

# SOUL.md is loaded fresh each message — edit docker/SOUL.md to customize personality
