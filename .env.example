# Hermes Agent Configuration
# Copy to .env and fill in your secrets

# ============================================================================
# API Keys & Credentials
# ============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional, if using OpenAI provider)
# OPENAI_API_KEY=sk-...

# Google Gemini (optional, if using Gemini provider)
# GOOGLE_API_KEY=...

# ============================================================================
# Telegram Gateway
# ============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# ============================================================================
# Docker & Container
# ============================================================================

# Data directory (mounted volume)
HERMES_HOME=/opt/data

# Dashboard
HERMES_DASHBOARD=1
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_HOST=0.0.0.0

# UID/GID mapping (for volume ownership)
HERMES_UID=10000
HERMES_GID=10000

# ============================================================================
# Railway Deployment
# ============================================================================

# Railway will auto-set these
# PORT=8080
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=...
# RAILWAY_SERVICE_NAME=...

# Skip gateway on Railway (dashboard-only mode)
# HERMES_RAILWAY_SKIP_GATEWAY=0

# ============================================================================
# Optional: OAuth Bootstrap (Railway provisioning only)
# ============================================================================

# For orchestrated deployments that seed OAuth non-interactively.
# First boot only — subsequent token rotations write to auth.json.
# HERMES_AUTH_JSON_BOOTSTRAP={"refresh_token":"..."}

# ============================================================================
# Agent Customization
# ============================================================================

# SOUL.md is loaded fresh each message — edit docker/SOUL.md to customize personality
